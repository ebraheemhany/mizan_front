# Backend API (mizan back). Used by Next.js route handlers on the server.
BACKEND_URL=http://localhost:4000
# Same backend, called directly from the browser with the access token.
NEXT_PUBLIC_API_URL=http://localhost:4000
# "Continue with Google": the Client ID of the "Web application" OAuth client (not a
# secret; the backend's GOOGLE_CLIENT_ID is the same value). Empty: no Google button.
# Read at build time, so a change needs a new build.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
